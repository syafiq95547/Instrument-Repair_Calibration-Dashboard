@page "/"
@page "/inventory"
@page "/calibrations"
@page "/repairs"
@page "/certificates"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable
<PageTitle>@PageTitle · InstrumentHub</PageTitle>
<div class="page-heading"><div><div class="eyebrow">YOUR LAB, AT A GLANCE</div><h1>@PageTitle</h1><p>@Subtitle</p></div><div class="heading-actions"><span class="date-pill"><Icon Name="calendar" Size="15" />@DateTime.UtcNow.ToString("MMM dd, yyyy") <span class="muted">UTC</span></span><button class="button primary" @onclick="()=>OpenInstrument(null)"><Icon Name="plus" Size="16" />Add instrument</button></div></div>
@if(error is not null){<div class="error-message" role="alert">@error <button @onclick="Refresh" class="text-button">Try again</button></div>}
@if(notice is not null){<div class="notice" role="status"><Icon Name="check" Size="16" />@notice<button class="icon-button" aria-label="Dismiss notification" @onclick="()=>notice=null"><Icon Name="close" Size="14" /></button></div>}
@if(loading){<div class="loading-state"><div class="spinner"></div><p>Loading your workspace…</p></div>}
else if(stats is not null){
@if(stats.DemoMode){<div class="demo-banner"><span class="demo-dot"></span><strong>Demo workspace</strong><span>Explore with sample records. Changes reset on server restart.</span><a href="/settings">Connect SQL Server <span>↗</span></a></div>}
@if(Page is "overview" or "inventory" or "calibrations"){
<div class="stats-grid">
<div class="stat-card"><div class="stat-label">Total instruments <Icon Name="box" Size="17" /></div><div class="stat-body"><strong>@stats.Total</strong><div class="spark green" aria-hidden="true">@foreach(var height in new[]{7,10,9,14,12,17,20,22,25,28}){<i style="height:@(height)px"></i>}</div></div><small><span class="positive">@departments.Count departments</span> <span>in your workspace</span></small></div>
<button class="stat-card clickable" @onclick='()=>SetFilter("Overdue")'><div class="stat-label">Overdue calibrations <Icon Name="alert" Size="17" /></div><div class="stat-body"><strong>@stats.Overdue</strong><span class="stat-symbol danger"><Icon Name="calendar" Size="30" /></span></div><small><span class="negative">Action required</span> <span>past calibration due date</span></small></button>
<button class="stat-card clickable" @onclick='()=>SetFilter("Due Soon")'><div class="stat-label">Due soon <Icon Name="clock" Size="17" /></div><div class="stat-body"><strong>@stats.DueSoon</strong><span class="stat-symbol amber"><Icon Name="clock" Size="30" /></span></div><small><span class="warning">Next 30 days</span> <span>including today</span></small></button>
<button class="stat-card clickable" @onclick='()=>Navigation.NavigateTo("/repairs")'><div class="stat-label">Under repair <Icon Name="wrench" Size="17" /></div><div class="stat-body"><strong>@stats.UnderRepair</strong><div class="spark gold" aria-hidden="true">@foreach(var height in new[]{9,16,22,28,21,17,22,13,17,12}){<i style="height:@(height)px"></i>}</div></div><small><span class="warning">@stats.OpenRepairs open orders</span> <span>in the repair queue</span></small></button>
<div class="stat-card compliance"><div class="stat-label">Compliance rate <Icon Name="shield" Size="17" /></div><div class="compliance-body"><div><strong>@stats.ComplianceRate<span>%</span></strong><small>Within calibration date</small></div><div class="ring" style="--rate:@(stats.ComplianceRate.ToString(System.Globalization.CultureInfo.InvariantCulture))%" role="img" aria-label="@($"Compliance rate: {stats.ComplianceRate}%")"><Icon Name="check" Size="22" /></div></div><small class="compliance-note" title="Calibrated and Due Soon instruments divided by all instruments except Out of Service.">Excludes out-of-service assets</small></div>
</div>
@if(stats.Overdue>0){<div class="alert-strip"><div><Icon Name="alert" Size="16" /><strong>@stats.Overdue instruments are overdue for calibration.</strong><span>Prioritize these assets to keep your lab compliant.</span></div><button class="text-button" @onclick='()=>SetFilter("Overdue")'>Review overdue assets <span>→</span></button></div>}
<section class="panel table-panel"><div class="panel-title"><div><h2>@(Page=="calibrations" ? "Calibration schedule" : Page=="inventory" ? "Instrument inventory" : "Recent calibration tasks")</h2><span class="count-label">@assets.Count assets</span></div><div class="panel-tools">@if(Page=="inventory"){<label class="button file-label"><Icon Name="upload" Size="15" />Import<InputFile OnChange="Import" accept=".csv,.xlsx" disabled="@busy" /></label>}<button class="button" @onclick="Export" disabled="@busy"><Icon Name="download" Size="15" />Export</button></div></div>
<div class="table-toolbar"><div class="tabs" aria-label="Filter by status">@foreach(var tab in Tabs){<button class="@(filter==tab.Status ? "selected" : "")" @onclick="()=>SetFilter(tab.Status)">@tab.Label <span>@Count(tab.Status)</span></button>}</div><div class="table-controls"><label class="table-search"><Icon Name="search" Size="15" /><input aria-label="Search equipment" placeholder="Search equipment…" value="@search" @oninput="SearchChanged" /></label><label class="department-select"><Icon Name="pin" Size="15" /><select aria-label="Filter by department" @bind="department" @bind:after="ResetPage"><option value="">All departments</option>@foreach(var dep in departments){<option>@dep</option>}</select></label><button class="button @(showFilters ? "active-filter" : "")" aria-expanded="@showFilters" @onclick="()=>showFilters=!showFilters"><Icon Name="filter" Size="15" />Filters</button></div></div>
@if(showFilters){<div class="filter-bar"><label>Calibration health<select aria-label="Calibration health" @bind="filter" @bind:after="ResetPage"><option value="">All statuses</option>@foreach(var status in HealthStatuses){<option>@status</option>}</select></label><label>Task result<select aria-label="Task result" @bind="taskFilter" @bind:after="ResetPage"><option value="">All results</option>@foreach(var status in CalibrationStatus.TaskStatuses){<option>@status</option>}</select></label><button class="text-button" @onclick="ClearFilters">Clear filters</button></div>}
<div class="table-scroll"><table><thead><tr><th class="instrument-column">Instrument name</th><th>Asset ID</th><th>Department</th><th><button class="sort-button" @onclick="()=>{sortDue=!sortDue;page=1;}">Due date <span>@(sortDue ? "↑" : "↕")</span></button></th><th>Calibration health</th><th>Task status</th><th class="action-column">Action</th></tr></thead><tbody>@foreach(var asset in Paged){<tr @key="asset.Id"><td><button class="instrument-name" @onclick="()=>OpenInstrument(asset)"><span class="instrument-icon"><Icon Name="@AssetIcon(asset.Name)" Size="20" /></span><span><strong>@asset.Name</strong><small>@asset.Model</small></span></button></td><td class="asset-id">@asset.AssetId</td><td><div class="cell-main">@asset.Department</div><small class="cell-sub">@asset.Location</small></td><td class="@(asset.Status=="Overdue" ? "overdue-date" : "")">@(asset.NextDueDate?.ToString("MMM dd, yyyy") ?? "Not scheduled")@if(asset.Status=="Overdue"){<small>@((DateOnly.FromDateTime(DateTime.UtcNow).DayNumber-asset.NextDueDate!.Value.DayNumber)) days overdue</small>}</td><td><span class="badge @StatusClass(asset.Status)"><i></i>@asset.Status</span></td><td><span class="task-badge @StatusClass(asset.TaskStatus)">@asset.TaskStatus</span></td><td><label class="upload-action @(busy ? "disabled" : "")" title="Upload PDF certificate for @asset.AssetId"><Icon Name="upload" Size="14" /><span>Certificate</span><InputFile aria-label="@($"Upload certificate for {asset.AssetId}")" OnChange="e=>Upload(asset.Id,e)" accept="application/pdf,.pdf" disabled="@busy" /></label></td></tr>}
@if(!Filtered.Any()){<tr><td colspan="7"><div class="empty-state"><Icon Name="search" Size="28" /><h3>No instruments found</h3><p>Try a different search or clear your filters.</p><button class="button" @onclick="ClearFilters">Clear filters</button></div></td></tr>}</tbody></table></div>
<div class="table-footer"><span>Showing @(Filtered.Any() ? (page-1)*pageSize+1 : 0)–@Math.Min(page*pageSize,Filtered.Count()) of @Filtered.Count() instruments</span><div class="pagination"><button aria-label="Previous page" disabled="@(page<=1)" @onclick="()=>page--">‹</button>@for(var i=1;i<=PageCount;i++){var number=i;<button class="@(page==number ? "current" : "")" aria-label="Page @number" aria-current="@(page==number ? "page" : null)" @onclick="()=>page=number">@number</button>}<button aria-label="Next page" disabled="@(page>=PageCount)" @onclick="()=>page++">›</button></div></div></section>
@if(Page=="overview"){
<div class="bottom-grid"><section class="panel repair-summary"><div class="panel-title"><div><Icon Name="wrench" Size="17" /><h2>Repair work orders</h2><span class="count-label">@stats.OpenRepairs open</span></div><a href="/repairs" class="text-link">View all orders <span>→</span></a></div><div class="mini-table">@foreach(var repair in repairs.Where(x=>x.Status!="Completed").Take(3)){<div class="mini-row"><span class="muted">WO-@repair.Id.ToString("D4")</span><div><strong>@repair.InstrumentName</strong><small>@repair.Issue</small></div><span class="badge @StatusClass(repair.Status)"><i></i>@repair.Status</span><span class="repair-person">@repair.Technician</span><span>@repair.OpenedDate.ToString("MMM dd")</span><a href="/repairs" aria-label="View repair order">↗</a></div>}@if(stats.OpenRepairs==0){<div class="compact-empty"><Icon Name="check" />No open repairs. Your queue is clear.</div>}</div></section>
<section class="panel availability"><div class="panel-title"><h2>Asset availability</h2><Icon Name="chart" Size="17" /></div><div class="availability-number"><strong>@stats.AvailabilityRate%</strong><span>ready for use</span><small>@(stats.Calibrated+stats.DueSoon) of @stats.Total assets</small></div><div class="availability-bar" role="img" aria-label="@($"{stats.AvailabilityRate}% ready for use")">@foreach(var segment in Availability){<span style="width:@(Percent(segment.Count))%;background:@segment.Color"></span>}</div>@foreach(var segment in Availability){<div class="legend"><span><i style="background:@segment.Color"></i>@segment.Label</span><strong>@segment.Count</strong></div>}</section></div>
}
}
else if(Page=="repairs"){
<section class="panel"><div class="panel-title"><div><h2>Repair work orders</h2><span class="count-label">@repairs.Count orders</span></div><button class="button primary" @onclick="OpenRepair"><Icon Name="plus" Size="16" />Log repair</button></div><div class="table-scroll"><table><thead><tr><th>Work order</th><th>Instrument</th><th>Issue</th><th>Technician</th><th>Opened</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var repair in repairs){<tr><td class="asset-id">WO-@repair.Id.ToString("D4")</td><td><strong>@repair.InstrumentName</strong><small class="cell-sub">@repair.AssetId</small></td><td>@repair.Issue</td><td>@repair.Technician</td><td>@repair.OpenedDate.ToString("MMM dd, yyyy")</td><td><span class="badge @StatusClass(repair.Status)"><i></i>@repair.Status</span></td><td>@if(repair.Status!="Completed"){<button class="button small" disabled="@busy" @onclick="()=>Complete(repair.Id)"><Icon Name="check" Size="14" />Complete</button>}else{<span class="positive">Closed</span>}</td></tr>}@if(repairs.Count==0){<tr><td colspan="7"><div class="empty-state"><Icon Name="wrench" Size="30" /><h3>No repair logs yet</h3><p>Log an issue to start tracking a repair.</p></div></td></tr>}</tbody></table></div></section>
}
else if(Page=="certificates"){
<section class="panel"><div class="panel-title"><div><h2>Calibration certificates</h2><span class="count-label">@certificates.Count documents</span></div><button class="button primary" @onclick="OpenCertificate"><Icon Name="upload" Size="16" />Upload certificate</button></div><div class="table-scroll"><table><thead><tr><th>Document</th><th>Asset ID</th><th>Instrument</th><th>Uploaded</th><th>File size</th><th>Action</th></tr></thead><tbody>@foreach(var cert in certificates){<tr><td><div class="document-name"><span class="instrument-icon"><Icon Name="file" /></span><strong>@cert.FileName</strong></div></td><td class="asset-id">@cert.AssetId</td><td>@assets.FirstOrDefault(x=>x.Id==cert.InstrumentId)?.Name</td><td>@cert.UploadedAt.ToString("MMM dd, yyyy · HH:mm") UTC</td><td>@((cert.Size/1024d).ToString("N1")) KB</td><td><button class="button small" disabled="@busy" @onclick="()=>DownloadCertificate(cert)"><Icon Name="download" Size="14" />Download</button></td></tr>}@if(certificates.Count==0){<tr><td colspan="6"><div class="empty-state certificate-empty"><span class="empty-icon"><Icon Name="file" Size="32" /></span><h3>Your audit trail starts here.</h3><p>Upload a calibration certificate and keep it linked to its instrument.<br />PDF documents, up to 10 MB each.</p><button class="button primary" @onclick="OpenCertificate"><Icon Name="upload" Size="16" />Upload first certificate</button></div></td></tr>}</tbody></table></div></section>
}
}
@if(modal is not null){
<div class="modal-backdrop" @onclick="CloseModal"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" @onclick:stopPropagation @onkeydown="ModalKeyDown"><div class="modal-header"><div><span class="eyebrow">INSTRUMENT WORKSPACE</span><h2 id="modal-title">@(modal=="instrument" ? edit.Id==0 ? "Add instrument" : "Instrument details" : modal=="repair" ? "Log a repair" : "Upload certificate")</h2></div><button class="icon-button" aria-label="Close dialog" disabled="@busy" @onclick="CloseModal"><Icon Name="close" /></button></div>
@if(modalError is not null){<div class="error-message" role="alert">@modalError</div>}
@if(modal=="instrument"){
<EditForm Model="edit" OnSubmit="SaveInstrument"><div class="form-grid"><label>Asset ID <span>*</span><InputText @bind-Value="edit.AssetId" required maxlength="64" placeholder="EQ-00249" /></label><label>Instrument name <span>*</span><InputText @bind-Value="edit.Name" required maxlength="160" placeholder="e.g. Analytical balance" /></label><label>Model / manufacturer<InputText @bind-Value="edit.Model" maxlength="160" placeholder="e.g. Mettler Toledo · XPR205" /></label><label>Department <span>*</span><InputText @bind-Value="edit.Department" required maxlength="100" list="department-options" /><datalist id="department-options">@foreach(var dep in departments){<option>@dep</option>}</datalist></label><label>Location<InputText @bind-Value="edit.Location" maxlength="160" placeholder="Lab A · Bench 04" /></label><label>Responsible owner<InputText @bind-Value="edit.Owner" maxlength="100" /></label><label>Last calibration<InputDate @bind-Value="edit.LastCalibrationDate" /></label><label>Next due date<InputDate @bind-Value="edit.NextDueDate" /></label><label>Manual status<InputSelect @bind-Value="edit.CurrentStatus">@foreach(var status in CalibrationStatus.ManualStatuses){<option>@status</option>}</InputSelect></label><label>Calibration task result<InputSelect @bind-Value="edit.TaskStatus">@foreach(var status in CalibrationStatus.TaskStatuses){<option>@status</option>}</InputSelect></label></div><div class="form-note"><Icon Name="shield" Size="16" /><span>Calibration health is calculated from the due date. In Repair and Out of Service take priority. Uploading a certificate does not change the due date.</span></div><div class="modal-footer"><button class="button" type="button" disabled="@busy" @onclick="CloseModal">Cancel</button><button class="button primary" type="submit" disabled="@busy">@(busy ? "Saving…" : "Save instrument")</button></div></EditForm>
}
else if(modal=="repair"){
<EditForm Model="repairEdit" OnSubmit="SaveRepair"><div class="form-stack"><label>Instrument <span>*</span><InputSelect @bind-Value="repairEdit.InstrumentId" required><option value="0">Select an instrument</option>@foreach(var asset in assets.Where(x=>x.CurrentStatus!="Out of Service")){<option value="@asset.Id">@asset.AssetId · @asset.Name</option>}</InputSelect></label><label>Issue description <span>*</span><InputTextArea @bind-Value="repairEdit.Issue" required maxlength="1000" rows="3" placeholder="Describe the problem…" /></label><label>Assigned technician <span>*</span><InputText @bind-Value="repairEdit.Technician" required maxlength="100" /></label></div><div class="form-note"><Icon Name="wrench" Size="16" />The instrument will be marked In Repair until all its work orders are completed.</div><div class="modal-footer"><button class="button" type="button" disabled="@busy" @onclick="CloseModal">Cancel</button><button class="button primary" type="submit" disabled="@busy">@(busy ? "Saving…" : "Create work order")</button></div></EditForm>
}
else {
<div class="form-stack"><label>Instrument<select @bind="certificateAsset"><option value="0">Select an instrument</option>@foreach(var asset in assets){<option value="@asset.Id">@asset.AssetId · @asset.Name</option>}</select></label><label class="upload-drop"><Icon Name="upload" Size="30" /><strong>@(busy ? "Uploading…" : "Choose a PDF certificate")</strong><span>Maximum file size: 10 MB</span><InputFile OnChange="e=>Upload(certificateAsset,e)" accept="application/pdf,.pdf" disabled="@(busy || certificateAsset==0)" aria-label="Choose PDF certificate" /></label></div>
}
</section></div>
}
@code {
List<InstrumentView> assets=[]; List<RepairLog> repairs=[]; List<Certificate> certificates=[]; DashboardStats? stats;
List<string> departments=[]; bool loading=true,busy,showFilters,sortDue; string? error,notice,modal,modalError; string search="",filter="",department="",taskFilter=""; int page=1; const int pageSize=7;
Instrument edit=new(); RepairLog repairEdit=new(); int certificateAsset; bool focusModal;
string Page=>new Uri(Navigation.Uri).AbsolutePath.Trim('/') switch { "inventory"=>"inventory", "calibrations"=>"calibrations", "repairs"=>"repairs", "certificates"=>"certificates", _=>"overview" };
string PageTitle=>Page switch { "inventory"=>"Instrument inventory", "calibrations"=>"Calibration schedule", "repairs"=>"Repair logs", "certificates"=>"Certificates", _=>"Equipment overview" };
string Subtitle=>Page switch { "inventory"=>"Every instrument, location, and owner. One organized workspace.", "calibrations"=>"Plan ahead, stay on schedule, and keep every measurement reliable.", "repairs"=>"Track issues from the first report to a successful return to service.", "certificates"=>"A complete, accessible audit trail for every calibration.", _=>"A clear view of your instruments, calibration health, and repair operations." };
static string[] HealthStatuses=["Calibrated","Due Soon","Overdue","In Repair","Out of Service","Pending Calibration"];
(string Label,string Status)[] Tabs=>[("All equipment",""),("Calibrated","Calibrated"),("Overdue","Overdue"),("In repair","In Repair")];
IEnumerable<InstrumentView> Filtered {
get {
var result=assets.Where(x=>(filter=="" || x.Status==filter) && (department=="" || x.Department==department) && (taskFilter=="" || x.TaskStatus==taskFilter) && (search=="" || $"{x.Name} {x.AssetId} {x.Model} {x.Department} {x.Owner}".Contains(search,StringComparison.OrdinalIgnoreCase)));
return sortDue ? result.OrderBy(x=>x.NextDueDate ?? DateOnly.MaxValue) : result;
} }
IEnumerable<InstrumentView> Paged=>Filtered.Skip((page-1)*pageSize).Take(pageSize);
int PageCount=>Math.Max(1,(int)Math.Ceiling(Filtered.Count()/(double)pageSize));
int Count(string status)=>status=="" ? assets.Count : assets.Count(x=>x.Status==status);
(string Label,int Count,string Color)[] Availability=>[("Available · within calibration date",stats!.Calibrated+stats.DueSoon,"#247c6b"),("In repair",stats.UnderRepair,"#dfb56a"),("Needs calibration",stats.Overdue+stats.Pending,"#e47b80"),("Out of service",stats.OutOfService,"#8c9caf")];
string Percent(int count)=>(stats!.Total==0 ? 0 : count*100m/stats.Total).ToString(System.Globalization.CultureInfo.InvariantCulture);
protected override async Task OnInitializedAsync(){ Navigation.LocationChanged+=LocationChanged; ApplyQuery(); await Refresh(); }
void ApplyQuery(){ var query=new Uri(Navigation.Uri).Query.TrimStart('?').Split('&',StringSplitOptions.RemoveEmptyEntries).Select(x=>x.Split('=',2)).Where(x=>x.Length==2).GroupBy(x=>x[0]).ToDictionary(x=>x.Key,x=>Uri.UnescapeDataString(x.Last()[1])); search=query.GetValueOrDefault("q",""); filter=query.GetValueOrDefault("status",""); page=1; }
void LocationChanged(object? sender,LocationChangedEventArgs args){ ApplyQuery(); _=InvokeAsync(StateHasChanged); }
public void Dispose()=>Navigation.LocationChanged-=LocationChanged;
async Task Refresh(){loading=true;error=null;try{
var a=Api.Get<List<InstrumentView>>("instruments");var r=Api.Get<List<RepairLog>>("repairs");var c=Api.Get<List<Certificate>>("certificates");var s=Api.Get<DashboardStats>("dashboard");await Task.WhenAll(a,r,c,s);
assets=await a;repairs=await r;certificates=await c;stats=await s;departments=assets.Select(x=>x.Department).Distinct().Order().ToList();page=Math.Min(page,PageCount);
}catch(Exception e){error=e.Message;}finally{loading=false;}}
void SetFilter(string status){filter=status;page=1;if(Page is not ("overview" or "inventory" or "calibrations"))Navigation.NavigateTo("/calibrations?status="+Uri.EscapeDataString(status));}
void SearchChanged(ChangeEventArgs e){search=e.Value?.ToString() ?? "";page=1;}
void ResetPage()=>page=1;
void ClearFilters(){filter="";taskFilter="";department="";search="";page=1;}
void OpenInstrument(InstrumentView? x){ edit=x is null ? new() : new Instrument { Id=x.Id,AssetId=x.AssetId,Name=x.Name,Model=x.Model,Department=x.Department,Location=x.Location,Owner=x.Owner,CurrentStatus=x.CurrentStatus,LastCalibrationDate=x.LastCalibrationDate,NextDueDate=x.NextDueDate,TaskStatus=x.TaskStatus };modal="instrument";modalError=null;focusModal=true; }
void OpenRepair(){repairEdit=new();modal="repair";modalError=null;focusModal=true;}
void OpenCertificate(){certificateAsset=0;modal="certificate";modalError=null;focusModal=true;}
async Task CloseModal(){if(!busy){modal=null;modalError=null;await JS.InvokeVoidAsync("instrumentHub.restoreFocus");}}
async Task ModalKeyDown(KeyboardEventArgs e){if(e.Key=="Escape")await CloseModal();}
protected override async Task OnAfterRenderAsync(bool first){if(focusModal){focusModal=false;await JS.InvokeVoidAsync("instrumentHub.trapDialog");}}
async Task SaveInstrument(){busy=true;modalError=null;try{await Api.SaveInstrument(edit);notice=edit.Id==0 ? "Instrument added to your inventory." : "Instrument details updated.";modal=null;await Refresh();await JS.InvokeVoidAsync("instrumentHub.restoreFocus");}catch(Exception e){modalError=e.Message;}finally{busy=false;}}
async Task SaveRepair(){busy=true;modalError=null;try{if(repairEdit.InstrumentId==0)throw new InvalidOperationException("Select an instrument.");await Api.Repair(repairEdit);notice="Repair logged. The instrument is now marked In Repair.";modal=null;await Refresh();await JS.InvokeVoidAsync("instrumentHub.restoreFocus");}catch(Exception e){modalError=e.Message;}finally{busy=false;}}
async Task Complete(int id){await Run(async()=>{await Api.Complete(id);notice="Repair completed. Calibration health has been recalculated.";await Refresh();});}
async Task Upload(int id,InputFileChangeEventArgs e){if(id==0){modalError="Select an instrument first.";return;}await Run(async()=>{await Api.Upload(id,e.File);modal=null;notice="Certificate uploaded and linked to the instrument.";await Refresh();await JS.InvokeVoidAsync("instrumentHub.restoreFocus");});}
async Task Export()=>await Run(()=>Api.Download("instruments/export",$"instruments-{DateTime.UtcNow:yyyy-MM-dd}.csv"));
async Task Import(InputFileChangeEventArgs e)=>await Run(async()=>{var count=await Api.Import(e.File);notice=$"Imported {count} instruments.";await Refresh();});
async Task DownloadCertificate(Certificate cert)=>await Run(()=>Api.Download($"certificates/{cert.Id}/download",cert.FileName));
async Task Run(Func<Task> action){busy=true;error=null;modalError=null;try{await action();}catch(Exception e){if(modal is null)error=e.Message;else modalError=e.Message;}finally{busy=false;}}
static string StatusClass(string status)=>status switch { "Calibrated" or "Completed"=>"success", "Overdue" or "Out of Spec"=>"danger", "Due Soon" or "In Repair" or "In Progress"=>"amber", _=>"neutral" };
static string AssetIcon(string name)=>name.ToLowerInvariant() switch { var n when n.Contains("balance")=>"scale", var n when n.Contains("chromatograph")=>"chart",var n when n.Contains("spectrophotometer")=>"pulse",var n when n.Contains("pressure")=>"gauge",var n when n.Contains("hplc")=>"flask",var n when n.Contains("multimeter")=>"bolt",var n when n.Contains("temperature")=>"thermometer", _=>"box" };
}
