@page "/settings"
@attribute [Authorize]
@inject ApiClient Api
@inject Session Session
<PageTitle>Settings · InstrumentHub</PageTitle>
<div class="page-heading"><div><div class="eyebrow">WORKSPACE CONFIGURATION</div><h1>Settings & integrations</h1><p>Connect your records, protect your data, and keep your lab in sync.</p></div></div>
@if(message is not null){<div class="@(failed ? "error-message" : "notice")" role="status">@message</div>}
<div class="settings-grid"><section class="panel settings-card"><span class="settings-icon"><Icon Name="box" Size="25" /></span><h2>Database connection</h2><span class="badge @(Session.DemoMode ? "amber" : "success")"><i></i>@(Session.DemoMode ? "Demo mode" : "SQL Server mode")</span><p>@(Session.DemoMode ? "This workspace uses temporary sample data. Records reset when the server restarts." : "Your records are persisted in the configured SQL Server database.")</p><div class="instruction-block">For persistent storage, configure the server’s connection string and disable DemoMode. LocalDB is supported on Windows; cloud and production deployments require a full SQL Server instance.</div><p class="muted">Connection secrets are managed on the server, never in the browser.</p></section>
<section class="panel settings-card"><span class="settings-icon"><Icon Name="pulse" Size="25" /></span><h2>Google Forms integration</h2><p>Automatically register instruments from a submitted Google Form.</p><div class="integration-endpoint"><span>POST</span><code>/api/webhook/form-submit</code></div><div class="instruction-block">Install the included Apps Script as a form-submit trigger. Set the dashboard URL and webhook key in Script Properties. Configure the matching key on the API server.</div><p class="muted">Duplicate asset IDs are rejected to protect existing records.</p></section>
<section class="panel settings-card"><span class="settings-icon"><Icon Name="shield" Size="25" /></span><h2>Database backup</h2><p>Create a verified-checksum, copy-only SQL Server backup on your organization’s Windows network share.</p><div class="instruction-block">The SQL Server service account must have write permission to the configured UNC directory. Certificates are stored separately and should be included in your file backup policy.</div><button class="button primary" disabled="@(busy || Session.DemoMode)" @onclick="Backup"><Icon Name="download" Size="16" />@(busy ? "Creating backup…" : "Create database backup")</button>@if(Session.DemoMode){<small class="muted">Available after connecting SQL Server.</small>}</section>
<section class="panel settings-card"><span class="settings-icon"><Icon Name="calendar" Size="25" /></span><h2>Calibration policy</h2><p>Health is calculated daily using UTC calendar dates.</p><ul class="policy-list"><li><span class="badge success">Calibrated</span> More than 30 days until due</li><li><span class="badge amber">Due Soon</span> Due within 30 days, including today</li><li><span class="badge danger">Overdue</span> Due date has passed</li><li><span class="badge neutral">Pending Calibration</span> No due date recorded</li></ul><div class="instruction-block">In Repair and Out of Service are manual overrides. They take priority over the due date.</div></section></div>
@code{ string? message;bool busy,failed;async Task Backup(){busy=true;message=null;try{await Api.Backup();failed=false;message="Database backup completed on your configured network share.";}catch(Exception e){failed=true;message=e.Message;}finally{busy=false;}} }
