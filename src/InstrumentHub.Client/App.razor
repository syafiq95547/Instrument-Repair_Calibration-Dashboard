<CascadingAuthenticationState>
<Router AppAssembly="@typeof(App).Assembly">
<Found Context="routeData"><AuthorizeRouteView RouteData="routeData" DefaultLayout="@typeof(MainLayout)"><NotAuthorized><LoginRedirect /></NotAuthorized></AuthorizeRouteView><FocusOnNavigate RouteData="routeData" Selector="h1" /></Found>
<NotFound><LayoutView Layout="@typeof(MainLayout)"><h1>Page not found</h1><p>The page you requested doesn’t exist.</p><a href="/">Return to dashboard</a></LayoutView></NotFound>
</Router>
</CascadingAuthenticationState>
